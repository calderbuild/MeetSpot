# MeetSpot Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Amap (高德地图) API credentials
AMAP_API_KEY=your_amap_api_key_here
AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here

# Optional: Amap JS API key (frontend maps, distinct from the Web service key)
# AMAP_JS_API_KEY=your_amap_js_api_key_here

# Optional: Google Maps Platform key (used for /en/ international scenarios)
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Optional: Port configuration (defaults to 8000)
PORT=8000

# Optional: PostgreSQL database URL (e.g. Supabase / Render)
# DATABASE_URL=postgresql://user:password@host:port/database
# Force pgbouncer transaction-mode compatibility if auto detection is not enough
# PGBOUNCER_TRANSACTION_MODE=true
# Comma-separated CORS origins for production, e.g. https://meetspot.app,https://www.meetspot.app
# CORS_ALLOW_ORIGINS=*

# Optional: LLM API (OpenAI-compatible endpoints, e.g. DeepSeek)
# LLM_API_KEY=sk-your-llm-api-key
# LLM_API_BASE=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# Optional: OpenAI API (legacy)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Log level
LOG_LEVEL=info

# Optional: Pay with 302 payment integration
PAY302_APP_ID=ccff86524c
PAY302_SECRET=
PAY302_API_URL=https://api.302.ai/v1/checkout
# Free daily requests per IP; set 0 to disable (competition demo uses 2)
FREE_DAILY_LIMIT=2
CREDIT_PRICE_CENTS=100
CREDITS_PER_PURCHASE=10

# Optional: Analytics
# BAIDU_TONGJI_ID=your_baidu_tongji_id
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
